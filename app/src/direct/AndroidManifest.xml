<?xml version="1.0" encoding="utf-8"?>
<!--
    Добавка манифеста ДЛЯ ПРЯМОЙ РАЗДАЧИ.

    Всё остальное берётся из app/src/main/AndroidManifest.xml — этот
    файл только дополняет его, а не заменяет.

    ЗАЧЕМ ОТДЕЛЬНЫЙ ФАЙЛ, а не строка в общем манифесте: разрешение
    ниже не должно попасть в бандл для Play ни при каких условиях.
    Самообновление мимо магазина — прямое нарушение его правил, и
    объявленное REQUEST_INSTALL_PACKAGES там вызвало бы вопросы на
    ревью, даже если бы кода обновления в сборке не было.

    Проверяется это по собранному пакету, а не на слово: в бандле play
    ни этого разрешения, ни адресов GitHub быть не должно.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Установка сборки поверх нынешней. Само по себе разрешение ничего
        не даёт: с Android 8 человек ещё и включает установку из этого
        приложения вручную, и мы отправляем его прямо в нужный
        переключатель, см. Update.askInstallPermission.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

</manifest>
