# ОБРАЗЕЦ. Значения тут ПУСТЫЕ и должны такими остаться.
#
# Настоящий файл называется keystore.properties, лежит рядом и в
# репозиторий не уезжает — .gitignore закрывает его строкой 18.
#
# ЭТОТ файл .gitignore НЕ закрывает: он и должен быть в репозитории,
# чтобы следующий человек знал, какие ключи нужны. Поэтому заполнять
# его нельзя — заполненный образец попадёт в git при первом же
# «git add .», и пароль подписи станет достоянием истории навсегда.
#
# Заполнять ВЛАДЕЛЬЦУ, и только keystore.properties. Пароли не должны
# проходить ни через кого больше: ни в переписке, ни в задачах, ни в
# логах.
#
# Без настоящего файла релизная сборка соберётся, но будет подписана
# ОТЛАДОЧНЫМ ключом и в Play не пойдёт. Сборка предупредит об этом
# отдельной строкой.

# Путь к хранилищу. Обратные слэши в .properties — служебные, поэтому
# либо прямые, либо удвоенные.
storeFile=C:/dev/keys/meridian-release.jks

storePassword=
keyAlias=meridian
keyPassword=
